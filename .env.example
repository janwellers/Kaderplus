# Kaderplus – Umgebungsvariablen
# Kopiere diese Datei zu ".env" und trage deine Werte ein.

# Port des Servers (optional, Standard 3000)
PORT=3000

# Datenbank (empfohlen für Produktion). Ohne DATABASE_URL werden Stellen und
# Eingänge nur in lokalen JSON-Dateien unter data/ gespeichert (nur für Dev,
# auf Render flüchtig!). Kostenlose Postgres-DB z. B. bei Neon oder Supabase.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Admin-Bereich (/admin) zum Anlegen/Bearbeiten von Stellen.
# Ohne ADMIN_PASSWORD ist der Admin in Produktion deaktiviert.
ADMIN_PASSWORD=
# Optionaler eigener Schlüssel zum Signieren der Login-Sitzung (empfohlen).
ADMIN_SECRET=

# E-Mail-Versand Variante A (empfohlen): Resend über HTTPS. Funktioniert auch
# dort, wo ausgehende SMTP-Ports gesperrt sind (z. B. Render Free-Tier).
# Key unter https://resend.com/api-keys erzeugen. Hat Vorrang vor SMTP.
RESEND_API_KEY=

# E-Mail-Versand Variante B: klassisches SMTP (z. B. Strato). Wird nur genutzt,
# wenn RESEND_API_KEY leer ist. Ohne beides werden Eingänge nur gespeichert.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" nur bei Port 465 (SSL); sonst leer lassen
SMTP_SECURE=

# Absenderadresse und Empfänger der Benachrichtigungen
MAIL_FROM=Kaderplus <no-reply@kaderplus.de>
NOTIFY_EMAIL=jan@kaderplus.de
